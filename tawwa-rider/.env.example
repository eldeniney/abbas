# Public Supabase configuration only. Copy to .env.local and fill in.
# NEVER put service_role keys, database passwords or private API keys here:
# every EXPO_PUBLIC_* value is embedded in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://supabase.operines.ae
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional rider support / legal links shown in the Account tab.
EXPO_PUBLIC_RIDER_SUPPORT_PHONE=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
