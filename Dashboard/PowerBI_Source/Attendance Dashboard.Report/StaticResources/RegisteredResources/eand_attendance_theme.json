{
  "name": "e& Attendance",
  "dataColors": [
    "#3A3A3A",
    "#E60000",
    "#8E8E8E",
    "#BDBDBD",
    "#7A8CA3",
    "#2E7D5B",
    "#C9A227",
    "#5C5C5C"
  ],
  "foreground": "#1F1F1F",
  "foregroundNeutralSecondary": "#6B6B6B",
  "foregroundNeutralTertiary": "#9A9A9A",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F4F4",
  "backgroundNeutral": "#E6E6E6",
  "tableAccent": "#E60000",
  "good": "#2E7D5B",
  "neutral": "#C9A227",
  "bad": "#E60000",
  "maximum": "#E60000",
  "center": "#BDBDBD",
  "minimum": "#D9D9D9",
  "null": "#D9D9D9",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F1F1F"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#2E2E2E"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#2E2E2E"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6B6B6B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6E6E6"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#2E2E2E"
              }
            },
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "transparency": 100,
            "foreground": {
              "solid": {
                "color": "#6B6B6B"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#F4F4F4"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#1F1F1F"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            },
            "titleSize": 12,
            "headerSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#1F1F1F"
              }
            },
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            },
            "textSize": 9,
            "fontFamily": "Segoe UI"
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#1F1F1F"
              }
            },
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            },
            "textSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F4F4"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EBEBEB"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}