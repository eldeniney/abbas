/// Canonical columns every attendance record is expected to carry (missing optional ones are added as null).
expression CanonicalColumns =
		{
		    "Employee Code", "Agency Emp ID", "Employee Name", "Source Name", "Business Unit", "Client Name",
		    "Cost Center", "Pay Calendar", "Shift Name", "Process Date", "Day", "Punch In Time", "Punch Out Time",
		    "Total Hours", "Status", "Punch In Terminal", "Punch Out Terminal", "Is Justified", "Status2"
		}
