/// Normalises a header name so that spelling, spacing and case differences between monthly files do not matter. "Punch Out Temrinal" -> "punchouttemrinal".
expression fnHeaderKey =
		(v as any) as text =>
		let
		    t = if v = null then "" else Text.From(v),
		    k = Text.Lower(Text.Select(t, {"a".."z", "A".."Z", "0".."9"}))
		in
		    k
	lineageTag: 2d7c3a1e-0b1c-4d7a-9c1a-000000000006

	annotation PBI_ResultType = Function

/// Map of normalised header keys to the canonical column names used by the model. Includes the "Punch Out Temrinal" typo and a few safe aliases.
