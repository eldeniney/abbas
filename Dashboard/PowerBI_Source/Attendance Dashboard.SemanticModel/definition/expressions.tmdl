/// Manual overrides for status classification. Add rows as (raw status text, category). Category must be one of: Present, Absent, Leave, Holiday, Weekend / Rest Day, Other. Keyword rules apply when no override matches.
expression StatusCategoryOverrides =
		let
		    Source = #table(
		        type table [Status = text, Category = text],
		        {
		            // Examples (remove or edit as needed):
		            // {"WFH", "Present"},
		            // {"Business Trip", "Present"},
		            // {"Sick Leave", "Leave"}
		        }
		    )
		in
		    Source
