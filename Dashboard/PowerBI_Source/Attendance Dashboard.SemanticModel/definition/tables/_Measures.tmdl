	measure 'Unrecognised Status Records' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[DQ Unrecognised Status] = 1 )
		formatString: #,0
		displayFolder: 06 Data Quality\By Issue
		lineageTag: 9cb49aee-def3-557b-a9d8-6ad538946f0f
	measure 'Blank Business Unit Records' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[DQ Blank Business Unit] = 1 )
		formatString: #,0
		displayFolder: 06 Data Quality\By Issue
		lineageTag: 606ae250-2bc9-5419-86ed-c06f5d6ec25a
