	/// Records with at least one data-integrity issue (missing key fields, invalid dates/times/hours, duplicates, blank organisation fields, unrecognised status). Missing punches are counted as attendance exceptions, not here.
	measure 'DQ Issue Records' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[DQ Issue Flag] = 1 )
		formatString: #,0
		displayFolder: 06 Data Quality
		lineageTag: b2a9f513-dae4-5927-a8f6-1a88a077f4fa
	/// Share of records without any data-integrity issue.
	measure 'Data Quality % (Clean Records)' = 1 - DIVIDE ( [DQ Issue Records], [Attendance Records] )
		formatString: 0.0%
		displayFolder: 06 Data Quality
		lineageTag: 9ce7da80-fbd2-501e-94b5-1a10c5a0623e
