	measure 'Invalid DateTime Records' = [Invalid Punch In Records] + [Invalid Punch Out Records]
		formatString: #,0
		displayFolder: 06 Data Quality\By Issue
		lineageTag: d128611d-082f-5db9-8e38-85a4d88ab904
	measure 'Missing Punch In Records' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[Missing Punch In Flag] = 1, FactAttendance[Is Duplicate Record] = 0 )
		formatString: #,0
		displayFolder: 06 Data Quality\By Issue
		lineageTag: e553b03b-1116-5e05-9247-5f420db4563f
	measure 'Missing Punch Out Records' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[Missing Punch Out Flag] = 1, FactAttendance[Is Duplicate Record] = 0 )
		formatString: #,0
		displayFolder: 06 Data Quality\By Issue
		lineageTag: cd323df5-b11f-58ec-bbdf-22879dc3bf53
	measure 'Missing Both Punches Records' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[Missing Both Punches Flag] = 1, FactAttendance[Is Duplicate Record] = 0 )
		formatString: #,0
		displayFolder: 06 Data Quality\By Issue
		lineageTag: 68277513-f4d6-5b33-84c8-7c343376f871
	/// Employee-days that have more than one (non-identical) record. Not necessarily an error - listed for review.
	measure 'Multiple-Record Employee Days' = CALCULATE ( [Employee Days], FactAttendance[Multiple Records Day Flag] = 1 )
		formatString: #,0
		displayFolder: 06 Data Quality
		lineageTag: 30645624-201c-574c-8b86-0fb4b73687fb
	/// Informational: records where source Total Hours and punch-to-punch duration differ by more than 30 minutes (breaks, rounding). Not counted as a data-quality issue.
	measure 'Hours Differ From Punches Records' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[DQ Hours Differ From Punches] = 1 )
		formatString: #,0
		displayFolder: 06 Data Quality
		lineageTag: dd79f525-4109-5ad7-bd04-369f2ae11c95
	/// Number of distinct Status values that the keyword rules could not classify. Map them in the StatusCategoryOverrides query.
	measure 'Unrecognised Status Values' = CALCULATE ( DISTINCTCOUNT ( FactAttendance[Status] ), FactAttendance[Record Status Category] = "Other" )
		formatString: #,0
		displayFolder: 06 Data Quality
		lineageTag: a875e73d-5c44-5e7a-bf2b-29e84de3b28c
	/// Use with DimDQIssueType[Issue Type] on the axis.
	measure 'DQ Issue Records by Type' =
				SWITCH (
				    SELECTEDVALUE ( DimDQIssueType[Issue Type] ),
				    "Missing Employee Code", [Missing Employee Code Records],
				    "Missing Employee Name", [Missing Employee Name Records],
				    "Missing Process Date", [Missing Process Date Records],
				    "Missing Total Hours (Present)", [Missing Total Hours Records (Present)],
				    "Invalid Total Hours", [Invalid Total Hours Records],
				    "Invalid Punch In", [Invalid Punch In Records],
				    "Invalid Punch Out", [Invalid Punch Out Records],
				    "Punch Out Before Punch In", [Punch Out Before Punch In Records],
				    "Duplicate Record", [Duplicate Records],
				    "Blank Status", [Blank Status Records],
				    "Unrecognised Status", [Unrecognised Status Records],
				    "Blank Business Unit", [Blank Business Unit Records],
				    "Blank Client", [Blank Client Records],
				    "Blank Shift", [Blank Shift Records],
				    [DQ Issue Records]
				)
		formatString: #,0
		displayFolder: 06 Data Quality
		lineageTag: 6f99cc67-1994-5d45-814e-ea4165e790bf
	/// Most recent Process Date in the whole dataset (ignores slicers).
	measure 'Latest Data Date' = CALCULATE ( MAX ( FactAttendance[Process Date] ), REMOVEFILTERS () )
		formatString: dd-mmm-yyyy
		displayFolder: 07 Refresh Information
		lineageTag: ed38cda0-2a51-5227-be14-77059740d557
	measure 'Earliest Data Date' = CALCULATE ( MIN ( FactAttendance[Process Date] ), REMOVEFILTERS () )
		formatString: dd-mmm-yyyy
		displayFolder: 07 Refresh Information
		lineageTag: a459bf87-8cae-58a2-a516-6f3fca903b5f
	measure 'Latest Month' = FORMAT ( [Latest Data Date], "mmmm yyyy" )
		displayFolder: 07 Refresh Information
		lineageTag: 099a8d42-3bc2-54a6-9ebe-f627541ea8e7
	/// Timestamp written by Power Query at the last refresh.
	measure 'Last Refresh' = MAX ( RefreshInfo[Refresh DateTime] )
		formatString: dd-mmm-yyyy hh:nn
		displayFolder: 07 Refresh Information
		lineageTag: c9d875fa-2e74-52d3-a8f8-fd41f320e94a
	measure 'Months Loaded' = CALCULATE ( DISTINCTCOUNTNOBLANK ( FactAttendance[Process Month Start] ), REMOVEFILTERS () )
		formatString: #,0
		displayFolder: 07 Refresh Information
		lineageTag: 9aa52b2c-dd56-5601-af01-4b0197d85b09
	measure 'Source Files Loaded' = CALCULATE ( DISTINCTCOUNT ( FactAttendance[Source File] ), REMOVEFILTERS () )
		formatString: #,0
		displayFolder: 07 Refresh Information
		lineageTag: 9d38a05e-6da4-5861-8ef6-b894e73ba4a8
	/// Period covered by the data in the current filter context.
	measure 'Selected Period' =
				VAR _mn = MIN ( FactAttendance[Process Date] )
				VAR _mx = MAX ( FactAttendance[Process Date] )
				RETURN
				    IF (
				        ISBLANK ( _mn ),
				        "No data for the current selection",
				        IF (
				            FORMAT ( _mn, "yyyymm" ) = FORMAT ( _mx, "yyyymm" ),
				            FORMAT ( _mn, "mmmm yyyy" ),
				            FORMAT ( _mn, "dd mmm yyyy" ) & " - " & FORMAT ( _mx, "dd mmm yyyy" )
				        )
				    )
		displayFolder: 07 Refresh Information
		lineageTag: fcf52aa2-e248-5298-b49f-84555cf69eef
	measure 'Data Status Line' =
				"Data through " & FORMAT ( [Latest Data Date], "dd mmm yyyy" )
				    & "   |   Refreshed " & FORMAT ( [Last Refresh], "dd mmm yyyy hh:mm AM/PM" )
				    & "   |   " & [Months Loaded] & " months, " & [Source Files Loaded] & " files"
		displayFolder: 07 Refresh Information
		lineageTag: bb9bba82-3427-55f8-8024-2d8deaeaee1d
	measure 'Records Summary Line' = FORMAT ( [Attendance Records], "#,0" ) & " records   |   " & FORMAT ( [Active Employees], "#,0" ) & " employees   |   " & [Selected Period]
		displayFolder: 07 Refresh Information
		lineageTag: 8c3b9ef1-f2bc-5085-b0be-eb0ec0cfca09
	measure 'Review Thresholds Text' =
				"Review thresholds (configurable, not HR policy): short < "
				    & FORMAT ( MAX ( RefreshInfo[Short Hours Threshold] ), "0.#" ) & " hrs  |  long > "
				    & FORMAT ( MAX ( RefreshInfo[Long Hours Threshold] ), "0.#" ) & " hrs  |  Status2 as exception: "
				    & IF ( MAX ( RefreshInfo[Status2 Treated As Exception] ), "Yes", "No" )
		displayFolder: 07 Refresh Information
		lineageTag: f65d266d-b53d-561e-8880-2b78f53f2526
	measure 'Insight - Workforce' =
				VAR _cur = [Employee Days]
				VAR _pm = [Employee Days PM]
				VAR _emp = [Active Employees]
				RETURN
				    IF (
				        ISBLANK ( _cur ),
				        "No attendance records in the current selection.",
				        FORMAT ( _emp, "#,0" ) & " employees and " & FORMAT ( _cur, "#,0" ) & " employee-days recorded"
				            & IF (
				                ISBLANK ( _pm ),
				                " (no previous month to compare).",
				                ", " & IF ( _cur >= _pm, "up ", "down " ) & FORMAT ( ABS ( DIVIDE ( _cur - _pm, _pm ) ), "0.0%" )
				                    & " versus the previous month (" & FORMAT ( _pm, "#,0" ) & ")."
				            )
				    )
		displayFolder: 08 Insights
		lineageTag: 4932552e-af7e-53a2-a185-d6ecc093847c
	measure 'Insight - Attendance' =
				VAR _cur = [Present % of Recorded Days]
				VAR _pm = [Present % of Recorded Days PM]
				RETURN
				    IF (
				        ISBLANK ( _cur ),
				        BLANK (),
				        "Present share of recorded days is " & FORMAT ( _cur, "0.0%" )
				            & IF (
				                ISBLANK ( _pm ),
				                ".",
				                " (" & FORMAT ( ( _cur - _pm ) * 100, "+0.0;-0.0;0.0" ) & " pp versus the previous month)."
				            )
				            & " Absent " & FORMAT ( [Absent % of Recorded Days], "0.0%" ) & ", leave " & FORMAT ( [Leave % of Recorded Days], "0.0%" ) & "."
				    )
		displayFolder: 08 Insights
		lineageTag: 43e3b886-6656-5e34-87ff-dda43771d450
	measure 'Insight - Hours' =
				VAR _cur = [Avg Hours / Worked Day]
				VAR _pm = [Avg Hours / Worked Day PM]
				RETURN
				    IF (
				        ISBLANK ( _cur ),
				        BLANK (),
				        "Average " & FORMAT ( _cur, "0.0" ) & " hrs per worked day across " & FORMAT ( [Total Worked Hours], "#,0" ) & " total hours"
				            & IF (
				                ISBLANK ( _pm ),
				                ".",
				                ", " & IF ( _cur >= _pm, "up ", "down " ) & FORMAT ( ABS ( _cur - _pm ), "0.0" ) & " hrs versus the previous month."
				            )
				    )
		displayFolder: 08 Insights
		lineageTag: ee019c63-81f7-539b-805e-13390cdabd15
	measure 'Insight - Missing Punches' =
				VAR _cur = [Missing Punch %]
				VAR _pm = [Missing Punch % PM]
				VAR _days = [Missing Punch Days]
				RETURN
				    IF (
				        ISBLANK ( [Punch-Expected Days] ),
				        BLANK (),
				        FORMAT ( _days, "#,0" ) & " employee-days have a missing punch (" & FORMAT ( _cur, "0.0%" ) & " of punch-expected days)"
				            & IF (
				                ISBLANK ( _pm ),
				                ".",
				                ", " & IF ( _cur >= _pm, "up ", "down " ) & FORMAT ( ABS ( _cur - _pm ) * 100, "0.0" ) & " pp versus the previous month."
				            )
				    )
		displayFolder: 08 Insights
		lineageTag: bee84977-5838-5ee6-a26b-4acbc80820e6
	measure 'Insight - Exceptions' =
				VAR _tot = [Exception Days]
				VAR _t =
				    ADDCOLUMNS ( VALUES ( DimBusinessUnit[Business Unit] ), "@ex", [Exception Days] )
				VAR _top = TOPN ( 1, _t, [@ex], DESC )
				VAR _name = MAXX ( _top, DimBusinessUnit[Business Unit] )
				VAR _ex = MAXX ( _top, [@ex] )
				RETURN
				    IF (
				        ISBLANK ( _tot ) || _tot = 0,
				        "No attendance exceptions recorded in the current selection.",
				        FORMAT ( _tot, "#,0" ) & " exception days (" & FORMAT ( [Exception % of Recorded Days], "0.0%" ) & " of recorded days). "
				            & _name & " has the largest share: " & FORMAT ( DIVIDE ( _ex, _tot ), "0%" ) & " (" & FORMAT ( _ex, "#,0" ) & " days)."
				    )
		displayFolder: 08 Insights
		lineageTag: 56e19651-6579-5e60-9dd6-8d0240d7f71b
	measure 'Insight - Focus Area' =
				VAR _minDays = 50
				VAR _t =
				    FILTER (
				        ADDCOLUMNS ( VALUES ( DimClient[Client Name] ), "@pe", [Punch-Expected Days], "@mp", [Missing Punch %] ),
				        [@pe] >= _minDays && NOT ISBLANK ( [@mp] ) && [@mp] > 0
				    )
				VAR _top = TOPN ( 1, _t, [@mp], DESC )
				VAR _name = MAXX ( _top, DimClient[Client Name] )
				VAR _mp = MAXX ( _top, [@mp] )
				RETURN
				    IF (
				        ISBLANK ( _name ),
				        "No client with at least " & _minDays & " punch-expected days has missing punches.",
				        _name & " has the highest missing-punch rate: " & FORMAT ( _mp, "0.0%" ) & " (clients with at least " & _minDays & " punch-expected days)."
				    )
		displayFolder: 08 Insights
		lineageTag: 09bfb5be-0b36-5624-8675-b4a07d1716c9
	/// Dynamic, factual statements derived from the current filter context. Shown in the insight panel (rows come from DimInsight).
	measure 'Insight Text' =
				SWITCH (
				    SELECTEDVALUE ( DimInsight[Insight Order] ),
				    1, [Insight - Workforce],
				    2, [Insight - Attendance],
				    3, [Insight - Hours],
				    4, [Insight - Missing Punches],
				    5, [Insight - Exceptions],
				    6, [Insight - Focus Area]
				)
		displayFolder: 08 Insights
		lineageTag: 6a815aae-ddfa-5615-acb2-29832cd891e8
	measure 'Employee Header' = SELECTEDVALUE ( DimEmployee[Employee Name], IF ( HASONEVALUE ( DimEmployee[Employee Code] ), "(Name not recorded)", "Select one employee (drill through from any table)" ) )
		displayFolder: 09 Employee 360
		lineageTag: 1eaf89e8-e387-5831-984b-59f439e15a82
	measure 'Employee Sub Header' =
				VAR _code = SELECTEDVALUE ( DimEmployee[Employee Code] )
				VAR _agency = SELECTEDVALUE ( DimEmployee[Agency Emp ID] )
				RETURN
				    IF ( ISBLANK ( _code ), BLANK (), "Employee Code " & _code & IF ( ISBLANK ( _agency ), "", "   |   Agency Emp ID " & _agency ) )
		displayFolder: 09 Employee 360
		lineageTag: 0d31a4d7-d6aa-563f-9cd5-9f6e78ff2959
	/// Assignments recorded in the selected period. Several values appear when the employee changed Client / Cost Center / Shift.
	measure 'Employee Assignment' =
				VAR _bu = CONCATENATEX ( VALUES ( FactAttendance[Business Unit] ), FactAttendance[Business Unit], ", " )
				VAR _cl = CONCATENATEX ( VALUES ( FactAttendance[Client Name] ), FactAttendance[Client Name], ", " )
				VAR _cc = CONCATENATEX ( VALUES ( FactAttendance[Cost Center] ), FactAttendance[Cost Center], ", " )
				VAR _sh = CONCATENATEX ( VALUES ( FactAttendance[Shift Name] ), FactAttendance[Shift Name], ", " )
				VAR _src = CONCATENATEX ( VALUES ( FactAttendance[Source Name] ), FactAttendance[Source Name], ", " )
				RETURN
				    IF (
				        ISBLANK ( [Attendance Records] ),
				        BLANK (),
				        "Business Unit: " & _bu & "   |   Client: " & _cl & "   |   Cost Center: " & _cc & "   |   Shift: " & _sh & "   |   Source: " & _src
				    )
		displayFolder: 09 Employee 360
		lineageTag: 33f71327-ad75-5246-80fc-ee7b9d531e94

	column 'Measure Holder'
		dataType: string
		isHidden
		lineageTag: 209d0907-ab34-51dd-936b-1fdb8079c487
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Measure Holder]

		annotation SummarizationSetBy = User

	partition _Measures = calculated
		mode: import
		source =
				ROW ( "Measure Holder", BLANK () )

