/// All report measures, organised in display folders.
table _Measures
	lineageTag: 3e680ac4-bdf5-5a89-a816-af50439f24d9

	/// Number of distinct employees with at least one attendance record in the selected context.
	measure 'Active Employees' = DISTINCTCOUNTNOBLANK ( FactAttendance[Employee Code] )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: 1ce86840-5955-5dcf-9c30-df6f979576f4
	/// Distinct employee-days (Employee Code + Process Date). Several records on the same day count once.
	measure 'Employee Days' = DISTINCTCOUNTNOBLANK ( FactAttendance[Employee Day Key] )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: 00c7febd-e819-5e86-9b2f-883438538e04
	/// Raw rows loaded from the source files (including exact duplicates).
	measure 'Attendance Records' = COUNTROWS ( FactAttendance )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: 11be3d18-803c-5bc3-a015-c91275c15043
	measure 'Attendance Records (Excl. Duplicates)' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[Is Duplicate Record] = 0 )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: b3ba4e9c-1571-5624-956e-e3b94c8b9629
	/// Average number of employees with a record per calendar day that has data.
	measure 'Avg Daily Employees' = AVERAGEX ( VALUES ( DimDate[Date] ), [Active Employees] )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: cb53f91f-73cb-5756-9415-fd50d607f714
	measure 'Days With Data' = DISTINCTCOUNTNOBLANK ( FactAttendance[Process Date] )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: 7e62cf38-d598-5dc4-8f29-f3fe84693493
	measure 'Employees Present (1+ Day)' = CALCULATE ( [Active Employees], FactAttendance[Status Category] = "Present" )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: c9423782-c755-5085-b719-2dbd8f392fa0
	measure 'Employees With Exceptions' = CALCULATE ( [Active Employees], FactAttendance[Exception Flag] = 1 )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: 43048e6c-d65e-5e56-b3f5-4b742fd5ca2d
	measure 'Employees With Missing Punch' = CALCULATE ( [Active Employees], FactAttendance[Day Missing Punch Flag] = 1 )
		formatString: #,0
		displayFolder: 01 Workforce
		lineageTag: 5dc2d817-e6f3-5c4f-a435-f77dc3fba878
	/// Employee-days whose resolved status category is 'Present'.
	measure 'Present Days' = CALCULATE ( [Employee Days], FactAttendance[Status Category] = "Present" )
		formatString: #,0
		displayFolder: 02 Attendance
		lineageTag: c9e076b5-bde4-5968-a14c-ef0a9edca0c4
	/// Employee-days whose resolved status category is 'Absent'.
	measure 'Absent Days' = CALCULATE ( [Employee Days], FactAttendance[Status Category] = "Absent" )
		formatString: #,0
		displayFolder: 02 Attendance
		lineageTag: 544cbec5-b551-55b4-9119-a60bdddf24ac
	/// Employee-days whose resolved status category is 'Leave'.
	measure 'Leave Days' = CALCULATE ( [Employee Days], FactAttendance[Status Category] = "Leave" )
		formatString: #,0
		displayFolder: 02 Attendance
		lineageTag: 1d1e387b-a6b4-505e-8029-4535ff25ff77
	/// Employee-days whose resolved status category is 'Holiday'.
	measure 'Holiday Days' = CALCULATE ( [Employee Days], FactAttendance[Status Category] = "Holiday" )
		formatString: #,0
		displayFolder: 02 Attendance
		lineageTag: 051879ef-e99c-5d67-8120-5966802e15fd
	/// Employee-days whose resolved status category is 'Weekend / Rest Day'.
	measure 'Rest Day Days' = CALCULATE ( [Employee Days], FactAttendance[Status Category] = "Weekend / Rest Day" )
		formatString: #,0
		displayFolder: 02 Attendance
		lineageTag: 137989bb-27ab-5f2b-8145-4c7d107bc848
	/// Employee-days whose resolved status category is 'Other'.
	measure 'Other Status Days' = CALCULATE ( [Employee Days], FactAttendance[Status Category] = "Other" )
		formatString: #,0
		displayFolder: 02 Attendance
		lineageTag: 57ac2490-49b8-589c-8da1-c2a8a7f26cb3
	/// Employee-days whose resolved status category is 'Unknown'.
	measure 'Unknown Status Days' = CALCULATE ( [Employee Days], FactAttendance[Status Category] = "Unknown" )
		formatString: #,0
		displayFolder: 02 Attendance
		lineageTag: bce3a1f1-9e8b-519f-b832-2f18ae71b3c1
	/// Share of recorded employee-days with a Present status. The source does not contain a roster, so this is a share of RECORDED days, not a true attendance rate.
	measure 'Present % of Recorded Days' = DIVIDE ( [Present Days], [Employee Days] )
		formatString: 0.0%
		displayFolder: 02 Attendance
		lineageTag: c3c1eb5d-a068-5edc-b239-8a7fbd99c2c3
	measure 'Absent % of Recorded Days' = DIVIDE ( [Absent Days], [Employee Days] )
		formatString: 0.0%
		displayFolder: 02 Attendance
		lineageTag: e74f6448-1d32-54a8-8384-58285e56a8d9
	measure 'Leave % of Recorded Days' = DIVIDE ( [Leave Days], [Employee Days] )
		formatString: 0.0%
		displayFolder: 02 Attendance
		lineageTag: eb251d2a-1788-582b-bb04-ae1bceaabfc3
	measure 'Other Status % of Recorded Days' = DIVIDE ( [Other Status Days] + [Unknown Status Days], [Employee Days] )
		formatString: 0.0%
		displayFolder: 02 Attendance
		lineageTag: 6af46609-1b5f-5af2-b819-c028b5e90e8e
	/// Present days divided by recorded days that are not Leave, Holiday or Rest days. Still based on recorded days only.
	measure 'Present % (Excl. Leave & Rest Days)' = DIVIDE ( [Present Days], [Employee Days] - [Leave Days] - [Holiday Days] - [Rest Days] )
		formatString: 0.0%
		displayFolder: 02 Attendance
		lineageTag: 45eeb627-73a6-5afb-ada2-5615bf2d15a7
	measure 'Status Share %' = DIVIDE ( [Employee Days], CALCULATE ( [Employee Days], REMOVEFILTERS ( DimStatus ) ) )
		formatString: 0.0%
		displayFolder: 02 Attendance
		lineageTag: 588e4bad-02e7-5689-a2fd-55aee3f1bb3e
	/// Sum of worked hours (source Total Hours, or hours calculated from punches when the source value is blank/invalid). Exact duplicate records are excluded.
	measure 'Total Worked Hours' = SUM ( FactAttendance[Worked Hours Decimal] )
		formatString: #,0 "hrs"
		displayFolder: 03 Hours
		lineageTag: 0ad06135-2760-554b-8539-b9e9bd4e3927
	/// Employee-days with recorded hours greater than zero.
	measure 'Worked Days' = CALCULATE ( [Employee Days], FactAttendance[Day Worked Hours] > 0 )
		formatString: #,0
		displayFolder: 03 Hours
		lineageTag: 201b6ba8-16ab-50c1-981f-91b7f7d57aae
	/// Total worked hours divided by employee-days that have hours > 0 (absent/leave days are not in the denominator).
	measure 'Avg Hours / Worked Day' = DIVIDE ( [Total Worked Hours], [Worked Days] )
		formatString: 0.0 "hrs"
		displayFolder: 03 Hours
		lineageTag: 51ebda7f-aced-58fa-b49d-8cad0c4a883b
	/// Total worked hours divided by active employees in the selected period.
	measure 'Avg Hours / Employee' = DIVIDE ( [Total Worked Hours], [Active Employees] )
		formatString: 0.0 "hrs"
		displayFolder: 03 Hours
		lineageTag: 35ee7a48-7497-5120-8d09-edf4ba396e8a
	measure 'Median Hours / Worked Day' = CALCULATE ( MEDIAN ( FactAttendance[Day Worked Hours] ), FactAttendance[Is Day Primary] = 1, FactAttendance[Day Worked Hours] > 0 )
		formatString: 0.0 "hrs"
		displayFolder: 03 Hours
		lineageTag: f88a6f4f-aff4-5341-b5a2-5dea11d094c8
	measure 'Min Hours / Worked Day' = CALCULATE ( MIN ( FactAttendance[Day Worked Hours] ), FactAttendance[Is Day Primary] = 1, FactAttendance[Day Worked Hours] > 0 )
		formatString: 0.0 "hrs"
		displayFolder: 03 Hours
		lineageTag: 7d91264a-130b-5257-9933-a5e25d9407b4
	measure 'Max Hours / Worked Day' = CALCULATE ( MAX ( FactAttendance[Day Worked Hours] ), FactAttendance[Is Day Primary] = 1 )
		formatString: 0.0 "hrs"
		displayFolder: 03 Hours
		lineageTag: 009b6962-47be-52db-a85d-61ef141246b1
	/// Employee-days whose hours had to be calculated from punches because the source Total Hours was blank or invalid.
	measure 'Days Using Calculated Hours' = CALCULATE ( [Employee Days], FactAttendance[Worked Hours Basis] = "Calculated from Punches" )
		formatString: #,0
		displayFolder: 03 Hours
		lineageTag: f05b077d-2bd1-5031-b144-cee06820e917
	measure 'Avg Punch In Minutes' = CALCULATE ( AVERAGE ( FactAttendance[Punch In Minutes From Midnight] ), FactAttendance[Is Duplicate Record] = 0 )
		formatString: 0
		isHidden
		displayFolder: 03 Hours\Punch
		lineageTag: c7c5b66c-a612-52af-8cb0-53c874ace345
	measure 'Avg Punch Out Minutes' = CALCULATE ( AVERAGE ( FactAttendance[Punch Out Minutes From Midnight] ), FactAttendance[Is Duplicate Record] = 0 )
		formatString: 0
		isHidden
		displayFolder: 03 Hours\Punch
		lineageTag: d1428834-8b0c-5cce-98fa-30c8793fcbcf
	/// Average punch-in clock time, computed from minutes since midnight (not from text).
	measure 'Avg Punch In Time' =
				VAR _m = [Avg Punch In Minutes]
				RETURN
				    IF ( ISBLANK ( _m ), BLANK (), FORMAT ( TIME ( 0, ROUND ( _m, 0 ), 0 ), "hh:mm AM/PM" ) )
		displayFolder: 03 Hours\Punch
		lineageTag: b17a1c71-73c1-5023-903b-8a3c2abccb31
	measure 'Avg Punch Out Time' =
				VAR _m = [Avg Punch Out Minutes]
				RETURN
				    IF ( ISBLANK ( _m ), BLANK (), FORMAT ( TIME ( 0, ROUND ( _m, 0 ), 0 ), "hh:mm AM/PM" ) )
		displayFolder: 03 Hours\Punch
		lineageTag: 648cd379-df70-59d5-9842-758842678da9
	/// Average punch-in time as decimal hours (7.5 = 07:30) for charts.
	measure 'Avg Punch In (Decimal Hours)' = DIVIDE ( [Avg Punch In Minutes], 60 )
		formatString: 0.00
		displayFolder: 03 Hours\Punch
		lineageTag: 9efdba74-0b3a-54b1-89f0-e32ef02a41be
	measure 'Avg Punch Out (Decimal Hours)' = DIVIDE ( [Avg Punch Out Minutes], 60 )
		formatString: 0.00
		displayFolder: 03 Hours\Punch
		lineageTag: 4c00362b-238d-52a4-b826-a93c861e394d
	/// Use with DimHour[Hour Label] on the axis.
	measure 'Punch In Records by Hour' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[Is Duplicate Record] = 0, TREATAS ( VALUES ( DimHour[Hour] ), FactAttendance[Punch In Hour] ) )
		formatString: #,0
		displayFolder: 03 Hours\Punch
		lineageTag: 8c20594d-4bff-55b0-bd7b-5701707e938d
	measure 'Punch Out Records by Hour' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[Is Duplicate Record] = 0, TREATAS ( VALUES ( DimHour[Hour] ), FactAttendance[Punch Out Hour] ) )
		formatString: #,0
		displayFolder: 03 Hours\Punch
		lineageTag: 7d4cf566-cbcb-5aa7-82af-80348b0a3f18
	/// Employee-days with at least one attendance exception: Absent, Missing Punch, Unrecognised Status, Short/Long hours (review thresholds) or a Status2 condition.
	measure 'Exception Days' = CALCULATE ( [Employee Days], FactAttendance[Exception Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions
		lineageTag: aeb33a5b-aa89-53db-bb81-6eb3b1d476be
	measure 'Exception % of Recorded Days' = DIVIDE ( [Exception Days], [Employee Days] )
		formatString: 0.0%
		displayFolder: 04 Exceptions
		lineageTag: 6659fa4a-1406-53e6-8bce-92b3965aa6c2
	measure 'Exception Days per Employee' = DIVIDE ( [Exception Days], [Employees With Exceptions] )
		formatString: 0.0
		displayFolder: 04 Exceptions
		lineageTag: c89302e2-f863-5026-9066-2b23ff2b2677
	measure 'Exception Days - Absent' = CALCULATE ( [Employee Days], FactAttendance[Exception Absent Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\By Type
		lineageTag: 39ef72c8-c522-5571-90c8-ba8160b93d98
	measure 'Exception Days - Missing Punch' = CALCULATE ( [Employee Days], FactAttendance[Exception Missing Punch Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\By Type
		lineageTag: 2248ec36-98a4-5b51-8ef5-859effcb7a59
	measure 'Exception Days - Unrecognised Status' = CALCULATE ( [Employee Days], FactAttendance[Exception Unrecognised Status Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\By Type
		lineageTag: ef08704d-c16a-5248-ad9a-37e0b7990786
	/// Present days with hours below the configurable review threshold (pShortHoursReviewThreshold). Not a policy violation.
	measure 'Exception Days - Short Hours (review)' = CALCULATE ( [Employee Days], FactAttendance[Exception Short Hours Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\By Type
		lineageTag: ec7b3ff1-d0bd-50c9-8a53-deccab6910a9
	/// Days with hours above the configurable review threshold (pLongHoursReviewThreshold). Not a policy violation.
	measure 'Exception Days - Long Hours (review)' = CALCULATE ( [Employee Days], FactAttendance[Exception Long Hours Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\By Type
		lineageTag: 62e32fd1-aa47-5dd7-af0e-1e60dba676be
	/// Days with a non-blank Status2 value (controlled by parameter pStatus2IsException).
	measure 'Exception Days - Status2 Condition' = CALCULATE ( [Employee Days], FactAttendance[Exception Status2 Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\By Type
		lineageTag: 7060a4a8-ed67-5cdb-b0ee-ec26879220ff
	/// Exception days split by DimExceptionType. A day with two exception types appears under both; the total is distinct days.
	measure 'Exception Days by Type' =
				SWITCH (
				    SELECTEDVALUE ( DimExceptionType[Exception Type] ),
				    "Absent", [Exception Days - Absent],
				    "Missing Punch", [Exception Days - Missing Punch],
				    "Unrecognised Status", [Exception Days - Unrecognised Status],
				    "Short Working Hours (review)", [Exception Days - Short Hours (review)],
				    "Long Working Hours (review)", [Exception Days - Long Hours (review)],
				    "Status2 Condition", [Exception Days - Status2 Condition],
				    [Exception Days]
				)
		formatString: #,0
		displayFolder: 04 Exceptions
		lineageTag: 1481c2b9-e086-5565-8cdf-712fa11f8960
	/// Employee-days where a punch was expected (Present status or one punch recorded) but Punch In and/or Punch Out is missing.
	measure 'Missing Punch Days' = CALCULATE ( [Employee Days], FactAttendance[Day Missing Punch Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\Punch
		lineageTag: cd2b0a77-15fe-573e-998b-793f8c5f1ac2
	measure 'Missing Punch In Days' = CALCULATE ( [Employee Days], FactAttendance[Missing Punch In Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\Punch
		lineageTag: ec4eda95-9354-5aba-98e3-0a10bb9b940d
	measure 'Missing Punch Out Days' = CALCULATE ( [Employee Days], FactAttendance[Missing Punch Out Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\Punch
		lineageTag: 243842c0-4d7c-5da5-8e4e-3f730c5b1e87
	measure 'Missing Both Punches Days' = CALCULATE ( [Employee Days], FactAttendance[Missing Both Punches Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\Punch
		lineageTag: f122bc98-7a2a-583f-b662-7690bb99db88
	/// Employee-days where punches are expected: Present status or at least one punch recorded. Absent / Leave / Rest days without punches are excluded.
	measure 'Punch-Expected Days' = CALCULATE ( [Employee Days], FactAttendance[Day Punch Expected Flag] = 1 )
		formatString: #,0
		displayFolder: 04 Exceptions\Punch
		lineageTag: 5aa51b7a-741f-54f7-a5f7-bf6bc2f2c6fc
	measure 'Complete Punch Days' = CALCULATE ( [Employee Days], FactAttendance[Day Punch Expected Flag] = 1, FactAttendance[Day Missing Punch Flag] = 0 )
		formatString: #,0
		displayFolder: 04 Exceptions\Punch
		lineageTag: 68170f13-6d3f-5885-83f4-05ecb3604f01
	/// Missing Punch Days divided by Punch-Expected Days.
	measure 'Missing Punch %' = DIVIDE ( [Missing Punch Days], [Punch-Expected Days] )
		formatString: 0.0%
		displayFolder: 04 Exceptions\Punch
		lineageTag: 68770f89-2d7d-5e1f-833d-2282f8fc354c
	measure 'Missing Punch Records' = CALCULATE ( COUNTROWS ( FactAttendance ), FactAttendance[Missing Punch Flag] = 1, FactAttendance[Is Duplicate Record] = 0 )
		formatString: #,0
		displayFolder: 04 Exceptions\Punch
		lineageTag: ec8869ec-c101-5284-8468-02d00c830e04
	measure 'Justified Exception Days' = CALCULATE ( [Exception Days], FactAttendance[Justification Category] = "Justified" )
		formatString: #,0
		displayFolder: 04 Exceptions\Justification
		lineageTag: 3af42c9e-e69f-5264-970d-128767545274
	/// Exception days where Is Justified explicitly says No.
	measure 'Not Justified Exception Days' = CALCULATE ( [Exception Days], FactAttendance[Justification Category] = "Not Justified" )
		formatString: #,0
		displayFolder: 04 Exceptions\Justification
		lineageTag: 8be9692c-4991-5320-b257-9b463bab9dcf
	measure 'Pending Justification Days' = CALCULATE ( [Exception Days], FactAttendance[Justification Category] = "Pending" )
		formatString: #,0
		displayFolder: 04 Exceptions\Justification
		lineageTag: ffdead87-40d6-5b33-80a5-87444d083236
	/// Exception days where Is Justified is blank. Blank is NOT treated as unjustified.
	measure 'Justification Not Recorded Days' = CALCULATE ( [Exception Days], FactAttendance[Justification Category] = "Not Recorded" )
		formatString: #,0
		displayFolder: 04 Exceptions\Justification
		lineageTag: a46d6121-b859-5854-b8cb-ebfb0b22de74
	measure 'Justified % (Where Recorded)' = DIVIDE ( [Justified Exception Days], [Justified Exception Days] + [Not Justified Exception Days] )
		formatString: 0.0%
		displayFolder: 04 Exceptions\Justification
		lineageTag: 56f08cc2-f4ba-56eb-8a6b-2242b7462338
	measure 'Latest Exception Date' = CALCULATE ( MAX ( FactAttendance[Process Date] ), FactAttendance[Exception Flag] = 1 )
		formatString: dd-mmm-yyyy
		displayFolder: 04 Exceptions
		lineageTag: b83577c1-0dad-5f26-8d0c-c479940e2ee7
	/// Plain-language list of the exception counts behind an employee's review ranking. No score is computed.
	measure 'Review Reasons' =
				VAR _a = [Exception Days - Absent]
				VAR _m = [Exception Days - Missing Punch]
				VAR _u = [Exception Days - Unrecognised Status]
				VAR _s = [Exception Days - Short Hours (review)]
				VAR _l = [Exception Days - Long Hours (review)]
				VAR _s2 = [Exception Days - Status2 Condition]
				VAR _txt =
				    IF ( _a > 0, "Absent " & _a & " | ", "" )
				        & IF ( _m > 0, "Missing punch " & _m & " | ", "" )
				        & IF ( _u > 0, "Unrecognised status " & _u & " | ", "" )
				        & IF ( _s > 0, "Short hours " & _s & " | ", "" )
				        & IF ( _l > 0, "Long hours " & _l & " | ", "" )
				        & IF ( _s2 > 0, "Status2 " & _s2 & " | ", "" )
				RETURN
				    IF ( LEN ( _txt ) > 3, LEFT ( _txt, LEN ( _txt ) - 3 ), BLANK () )
		displayFolder: 04 Exceptions
		lineageTag: 8b8b1c76-41c7-5963-8827-d5f49104c1e9
	/// Font colour helper: red when the row's exception rate is more than 1.5x the overall rate for the same period (minimum 20 employee-days).
	measure 'Exception % Colour' =
				VAR _overall =
				    CALCULATE (
				        [Exception % of Recorded Days],
				        REMOVEFILTERS ( DimBusinessUnit, DimClient, DimCostCenter, DimShift, DimSource, DimPayCalendar, DimEmployee )
				    )
				RETURN
				    IF ( [Exception % of Recorded Days] > 1.5 * _overall && [Employee Days] >= 20, "#E60000", "#2E2E2E" )
		isHidden
		displayFolder: 04 Exceptions\Formatting
		lineageTag: b3a3e44e-44d1-50e0-ba92-a5f944153aba
	measure 'Missing Punch % Colour' =
				VAR _overall =
				    CALCULATE (
				        [Missing Punch %],
				        REMOVEFILTERS ( DimBusinessUnit, DimClient, DimCostCenter, DimShift, DimSource, DimPayCalendar, DimEmployee )
				    )
				RETURN
				    IF ( [Missing Punch %] > 1.5 * _overall && [Punch-Expected Days] >= 20, "#E60000", "#2E2E2E" )
		isHidden
		displayFolder: 04 Exceptions\Formatting
		lineageTag: 5b012e57-8e98-5b60-a508-13aa852749a4
	/// Active Employees for the previous month (same day range shifted back one month).
	measure 'Active Employees PM' = CALCULATE ( [Active Employees], DATEADD ( DimDate[Date], -1, MONTH ) )
		formatString: #,0
		displayFolder: 05 Month Comparison
		lineageTag: b376c126-059a-5ac1-bb05-c6252e907828
	measure 'Active Employees MoM' = IF ( ISBLANK ( [Active Employees] ) || ISBLANK ( [Active Employees PM] ), BLANK (), [Active Employees] - [Active Employees PM] )
		formatString: #,0
		displayFolder: 05 Month Comparison
		lineageTag: d76a3008-bb6b-5114-bdb2-102e99fa9089
	measure 'Active Employees MoM %' = DIVIDE ( [Active Employees MoM], [Active Employees PM] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Month Comparison
		lineageTag: 8e90f460-3544-5a06-ad5b-471c6594c7dd
	measure 'KPI Note - Active Employees' =
				VAR _cur = [Active Employees]
				VAR _pm = [Active Employees PM]
				VAR _d = [Active Employees MoM %]
				RETURN
				    IF (
				        ISBLANK ( _pm ) || ISBLANK ( _cur ),
				        "No previous-month data",
				        IF ( _d > 0, UNICHAR ( 9650 ) & " ", IF ( _d < 0, UNICHAR ( 9660 ) & " ", UNICHAR ( 9644 ) & " " ) )
				            & FORMAT ( _d, "+0.0%;-0.0%;0.0%" ) & " vs prev. month (" & FORMAT ( _pm, "#,0" ) & ")"
				    )
		isHidden
		displayFolder: 05 Month Comparison\KPI Notes
		lineageTag: a2f08d12-8fd0-5aca-a2eb-10ad06f43e72
	measure 'KPI Colour - Active Employees' =
				VAR _d = [Active Employees MoM %]
				RETURN
				    IF ( ISBLANK ( _d ), "#6B6B6B", "#6B6B6B" )
		isHidden
		displayFolder: 05 Month Comparison\KPI Notes
		lineageTag: 14c7bbea-b3e8-582a-9213-fc312b371983
	/// Employee Days for the previous month (same day range shifted back one month).
	measure 'Employee Days PM' = CALCULATE ( [Employee Days], DATEADD ( DimDate[Date], -1, MONTH ) )
		formatString: #,0
		displayFolder: 05 Month Comparison
		lineageTag: 6c5060be-150c-50b0-beca-bd5e2e9c1f8d
	measure 'Employee Days MoM' = IF ( ISBLANK ( [Employee Days] ) || ISBLANK ( [Employee Days PM] ), BLANK (), [Employee Days] - [Employee Days PM] )
		formatString: #,0
		displayFolder: 05 Month Comparison
		lineageTag: b4b4e9a6-9bc9-5e2b-b2b4-0bf2beb9403a
