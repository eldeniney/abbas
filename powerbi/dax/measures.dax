// Prime Sales Performance - measure definitions (table: _Measures)
// Generated by tools/build_pbip.py. Paste into Power BI Desktop / Tabular Editor as needed.

// ===== 01 Core =====

// Incentive points credited on activations in the current filter context.
// format: #,0
Total Points =
    SUM ( Fact_Activations[Points] )

// Volume of activations (activated lines/services).
// format: #,0
Total VOA =
    SUM ( Fact_Activations[Quantity] )

// Activations that are eligible for points (the QTY shown in the director/product matrix).
// format: #,0
Points QTY =
    CALCULATE ( [Total VOA], Fact_Activations[PointsEligible] = TRUE () )

// Row count of the fact table.
// format: #,0
Activation Rows =
    COUNTROWS ( Fact_Activations )

// Average points per activated unit.
// format: 0.00
Points per Activation =
    DIVIDE ( [Total Points], [Total VOA] )

// Sellers with at least one activation in context.
// format: #,0
Active Sellers =
    COUNTROWS ( FILTER ( VALUES ( Dim_KAM[KAM_ID] ), [Total VOA] > 0 ) )

// Productivity: points per seller with activations.
// format: #,0
Points per Active Seller =
    DIVIDE ( [Total Points], [Active Sellers] )

// Share of total points across all sellers currently selected.
// format: 0.0%
Contribution % =
    DIVIDE ( [Total Points], CALCULATE ( [Total Points], ALLSELECTED ( Dim_KAM ) ) )

// ===== 02 Product =====

// format: #,0
Mobile VOA =
    CALCULATE ( [Total VOA], Dim_Product[Product Group] = "Mobile" )

// format: #,0
Fixed VOA =
    CALCULATE ( [Total VOA], Dim_Product[Product Group] = "Fixed" )

// format: #,0
Digital VOA =
    CALCULATE ( [Total VOA], Dim_Product[Product Group] = "Digital" )

// format: #,0
Devices VOA =
    CALCULATE ( [Total VOA], Dim_Product[Product Group] = "Devices" )

// format: #,0
Mobile Points =
    CALCULATE ( [Total Points], Dim_Product[Product Group] = "Mobile" )

// format: #,0
Fixed Points =
    CALCULATE ( [Total Points], Dim_Product[Product Group] = "Fixed" )

// format: #,0
Digital Points =
    CALCULATE ( [Total Points], Dim_Product[Product Group] = "Digital" )

// format: #,0
Devices Points =
    CALCULATE ( [Total Points], Dim_Product[Product Group] = "Devices" )

// Total GSM activations.
// format: #,0
GSM VOA =
    CALCULATE ( [Total VOA], Dim_Product[Reporting Line] = "GSM" )

// format: #,0
Fiber VOA =
    CALCULATE ( [Total VOA], Dim_Product[Reporting Line] = "Fiber" )

// format: #,0
WFA VOA =
    CALCULATE ( [Total VOA], Dim_Product[Reporting Line] = "WFA" )

// format: #,0
BIB VOA =
    CALCULATE ( [Total VOA], Dim_Product[Reporting Line] = "BIB" )

// Mobile number portability activations.
// format: #,0
MNP VOA =
    CALCULATE ( [Total VOA], Fact_Activations[PortIn] = "MNP" )

// Fixed number portability activations.
// format: #,0
FNP VOA =
    CALCULATE ( [Total VOA], Fact_Activations[PortIn] = "FNP" )

// format: 0.0%
MNP Share of GSM % =
    DIVIDE ( [MNP VOA], [GSM VOA] )

// format: 0.0%
FNP Share of Fixed % =
    DIVIDE ( [FNP VOA], [Fixed VOA] )

// format: 0.0%
Fiber Share of Fixed % =
    DIVIDE ( [Fiber VOA], [Fixed VOA] )

// format: 0.0%
Mobile Share of Points % =
    DIVIDE ( [Mobile Points], [Total Points] )

// ===== 03 Time =====

// Latest activation date in the whole fact table. Replace with TODAY() if the extract is refreshed daily.
// format: dd-mmm-yyyy
As-Of Date =
    CALCULATE ( MAX ( Fact_Activations[ActivationDate] ), REMOVEFILTERS () )

// format: dd-mmm-yyyy
Last Activation Date =
    MAX ( Fact_Activations[ActivationDate] )

// format: 0
Days Since Last Activation =
    IF ( NOT ISBLANK ( [Last Activation Date] ), DATEDIFF ( [Last Activation Date], [As-Of Date], DAY ) )

// Calendar days in the selected period up to the as-of date.
// format: 0
Days Elapsed =
    VAR AsOf = [As-Of Date]
    RETURN
        COUNTROWS ( FILTER ( VALUES ( Dim_Date[Date] ), Dim_Date[Date] <= AsOf ) )

// format: 0
Days In Period =
    COUNTROWS ( VALUES ( Dim_Date[Date] ) )

// format: 0
Days Remaining =
    [Days In Period] - [Days Elapsed]

// format: #,0
Points MTD =
    TOTALMTD ( [Total Points], Dim_Date[Date] )

// format: #,0
VOA MTD =
    TOTALMTD ( [Total VOA], Dim_Date[Date] )

// Month-to-date cumulative points, blank after the as-of date so the line stops.
// format: #,0
Points Cumulative =
    IF ( MAX ( Dim_Date[Date] ) <= [As-Of Date], [Points MTD] )

// format: #,0
Points Prev Month =
    CALCULATE ( [Total Points], PREVIOUSMONTH ( Dim_Date[Date] ) )

// Same day-range of the previous month (like-for-like comparison).
// format: #,0
Points Prev Month Same Period =
    VAR AsOf = MIN ( [As-Of Date], MAX ( Dim_Date[Date] ) )
    VAR PeriodStart = DATE ( YEAR ( MIN ( Dim_Date[Date] ) ), MONTH ( MIN ( Dim_Date[Date] ) ), 1 )
    RETURN
        CALCULATE (
            [Total Points],
            DATEADD ( DATESBETWEEN ( Dim_Date[Date], PeriodStart, AsOf ), -1, MONTH )
        )

// format: +0.0%;-0.0%;0.0%
Points MoM % =
    DIVIDE ( [Total Points] - [Points Prev Month Same Period], [Points Prev Month Same Period] )

// format: #,0
VOA Prev Month Same Period =
    VAR AsOf = MIN ( [As-Of Date], MAX ( Dim_Date[Date] ) )
    VAR PeriodStart = DATE ( YEAR ( MIN ( Dim_Date[Date] ) ), MONTH ( MIN ( Dim_Date[Date] ) ), 1 )
    RETURN
        CALCULATE (
            [Total VOA],
            DATEADD ( DATESBETWEEN ( Dim_Date[Date], PeriodStart, AsOf ), -1, MONTH )
        )

// format: +0.0%;-0.0%;0.0%
VOA MoM % =
    DIVIDE ( [Total VOA] - [VOA Prev Month Same Period], [VOA Prev Month Same Period] )

// Average points per calendar day so far.
// format: #,0.0
Daily Run-Rate (Points) =
    DIVIDE ( [Total Points], [Days Elapsed] )

// format: #,0.0
Daily Run-Rate (VOA) =
    DIVIDE ( [Total VOA], [Days Elapsed] )

// Linear run-rate projection to period end. Method: MTD + daily run-rate x days remaining.
// format: #,0
Points Forecast (Run-Rate) =
    [Total Points] + [Daily Run-Rate (Points)] * [Days Remaining]

// format: #,0
VOA Forecast (Run-Rate) =
    [Total VOA] + [Daily Run-Rate (VOA)] * [Days Remaining]

// format: #,0
VOA Last 7 Days =
    VAR AsOf = [As-Of Date]
    RETURN
        CALCULATE ( [Total VOA], DATESBETWEEN ( Dim_Date[Date], AsOf - 6, AsOf ) )

// format: #,0.0
Avg Daily VOA Last 7 Days =
    DIVIDE ( [VOA Last 7 Days], 7 )

// ===== 04 Target =====

// Full-month target for the month(s) in context (targets are stored per month per seller).
// format: #,0
Points Target =
    VAR StartD = DATE ( YEAR ( MIN ( Dim_Date[Date] ) ), MONTH ( MIN ( Dim_Date[Date] ) ), 1 )
    VAR EndD = EOMONTH ( MAX ( Dim_Date[Date] ), 0 )
    RETURN
        CALCULATE ( SUM ( Dim_Target[Points Target] ), DATESBETWEEN ( Dim_Date[Date], StartD, EndD ) )

// format: #,0
VOA Target =
    VAR StartD = DATE ( YEAR ( MIN ( Dim_Date[Date] ) ), MONTH ( MIN ( Dim_Date[Date] ) ), 1 )
    VAR EndD = EOMONTH ( MAX ( Dim_Date[Date] ), 0 )
    RETURN
        CALCULATE ( SUM ( Dim_Target[VOA Target] ), DATESBETWEEN ( Dim_Date[Date], StartD, EndD ) )

// Full-month target prorated linearly to the as-of date.
// format: #,0
Points Target To Date =
    [Points Target] * DIVIDE ( [Days Elapsed], [Days In Period] )

// format: 0.0%
Achievement % (To Date) =
    DIVIDE ( [Total Points], [Points Target To Date] )

// format: 0.0%
Achievement % (Full Month) =
    DIVIDE ( [Total Points], [Points Target] )

// format: 0.0%
VOA Achievement % =
    DIVIDE ( [Total VOA], [VOA Target] )

// Points still needed to reach the full-month target.
// format: #,0
Gap to Target =
    [Points Target] - [Total Points]

// Points per remaining day needed to close the gap.
// format: #,0.0
Required Daily Run-Rate =
    MAX ( 0, DIVIDE ( [Gap to Target], [Days Remaining] ) )

// format: 0.0%
Forecast Achievement % =
    DIVIDE ( [Points Forecast (Run-Rate)], [Points Target] )

// Linear target line by day of month.
// format: #,0
Cumulative Target =
    [Points Target] * DIVIDE ( DAY ( MAX ( Dim_Date[Date] ) ), DAY ( EOMONTH ( MAX ( Dim_Date[Date] ), 0 ) ) )

// RAG status against the prorated target.
Target Status =
    SWITCH (
        TRUE (),
        ISBLANK ( [Points Target] ), "No target",
        [Achievement % (To Date)] >= 1, "On track",
        [Achievement % (To Date)] >= 0.9, "At risk",
        "Behind"
    )

// Hex colour used for conditional formatting.
Target Status Colour =
    SWITCH ( [Target Status], "On track", "#1E5E3E", "At risk", "#E0A800", "Behind", "#A3122E", "#7F7F7F" )

// ===== 05 Ranking =====

// format: 0
Seller Rank (Points) =
    IF ( NOT ISBLANK ( [Total Points] ), RANKX ( ALLSELECTED ( Dim_KAM[KAM] ), [Total Points], , DESC, DENSE ) )

// format: 0
Seller Rank (VOA) =
    IF ( NOT ISBLANK ( [Total VOA] ), RANKX ( ALLSELECTED ( Dim_KAM[KAM] ), [Total VOA], , DESC, DENSE ) )

// Driven by the Top N slicer (default 10).
// format: 0
Top N Value =
    SELECTEDVALUE ( 'Top N'[Top N], 10 )

// 1 for sellers inside the Top N.
// format: 0
Top N Flag =
    IF ( [Seller Rank (Points)] <= [Top N Value], 1, 0 )

// format: 0
Director Rank =
    RANKX ( ALLSELECTED ( Dim_KAM[Director] ), [Total Points], , DESC, DENSE )

// Top director highlighted in red, as in the reference.
Director Bar Colour =
    IF ( [Director Rank] = 1, "#A3122E", "#2F6B45" )

Seller Activity Status =
    SWITCH (
        TRUE (),
        ISBLANK ( [Last Activation Date] ), "No activations",
        [Days Since Last Activation] > 7, "Inactive 7d+",
        [Days Since Last Activation] > 3, "Quiet 3d+",
        "Active"
    )

// format: #,0
Inactive Sellers (7d+) =
    COUNTROWS (
        FILTER (
            VALUES ( Dim_KAM[KAM_ID] ),
            ISBLANK ( [Last Activation Date] ) || [Days Since Last Activation] > 7
        )
    )

// ===== 06 Data Quality =====

// Fact rows whose KAM_ID is not in Dim_KAM.
// format: #,0
DQ Rows Missing Seller =
    COUNTROWS ( FILTER ( Fact_Activations, ISBLANK ( RELATED ( Dim_KAM[KAM] ) ) ) )

// format: #,0
DQ Rows Missing Product =
    COUNTROWS ( FILTER ( Fact_Activations, ISBLANK ( RELATED ( Dim_Product[Product] ) ) ) )

// format: #,0
DQ Zero-Point Eligible Rows =
    CALCULATE ( COUNTROWS ( Fact_Activations ), Fact_Activations[PointsEligible] = TRUE (), Fact_Activations[Points] <= 0 )

// format: #,0
DQ Future-Dated Rows =
    COUNTROWS ( FILTER ( Fact_Activations, Fact_Activations[ActivationDate] > TODAY () ) )

// format: #,0
DQ Duplicate IDs =
    COUNTROWS ( Fact_Activations ) - DISTINCTCOUNT ( Fact_Activations[ActivationID] )

// format: #,0
DQ Exceptions Total =
    [DQ Rows Missing Seller] + [DQ Rows Missing Product] + [DQ Zero-Point Eligible Rows] + [DQ Future-Dated Rows] + [DQ Duplicate IDs]

// format: 0.00%
DQ Exception Rate % =
    DIVIDE ( [DQ Exceptions Total], [Activation Rows] )

// ===== 07 Labels =====

// Timestamp captured by Power Query at refresh time.
Refresh Label =
    "T: " & FORMAT ( MAX ( Last_Refresh[Refreshed] ), "dd MMM yyyy - hh:mm AM/PM" )

Period Label =
    "Data to " & FORMAT ( [As-Of Date], "dd MMM yyyy" )
