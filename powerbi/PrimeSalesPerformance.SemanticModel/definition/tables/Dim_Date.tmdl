	column 'Year Month'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b75f01dd-30b8-5f9a-b121-62832eac30a9
		summarizeBy: none
		sourceColumn: [Year Month]

		annotation SummarizationSetBy = Automatic

	column 'Month Offset' =
			VAR AsOf = CALCULATE ( MAX ( Fact_Activations[ActivationDate] ), REMOVEFILTERS () )
			RETURN
			    DATEDIFF ( DATE ( YEAR ( AsOf ), MONTH ( AsOf ), 1 ), Dim_Date[Month Start], MONTH )
		dataType: int64
		formatString: 0
		lineageTag: 21306314-033e-5637-b6af-98d291a7b144
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Latest Month' = Dim_Date[Month Offset] = 0
		dataType: boolean
		lineageTag: 5009b215-2a74-5329-a3b9-2e481dc68c53
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Relative Month' =
			SWITCH ( TRUE (), Dim_Date[Month Offset] = 0, "Latest month", Dim_Date[Month Offset] = -1, "Previous month",
			    Dim_Date[Month Offset] < -1, "Earlier", "Future" )
		dataType: string
		lineageTag: 05a169b7-ef61-53fb-b601-13f71221ae3f
		summarizeBy: none
		sortByColumn: 'Month Offset'

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				VAR MinD = DATE ( YEAR ( MIN ( Fact_Activations[ActivationDate] ) ), 1, 1 )
				VAR MaxD = DATE ( YEAR ( MAX ( Fact_Activations[ActivationDate] ) ), 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( MinD, MaxD ),
				        "Year", YEAR ( [Date] ),
				        "Month Number", MONTH ( [Date] ),
				        "Month", FORMAT ( [Date], "MMM yyyy" ),
				        "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				        "Day", DAY ( [Date] ),
				        "Weekday", FORMAT ( [Date], "ddd" ),
				        "Weekday Number", WEEKDAY ( [Date], 2 ),
				        "Is Weekend", WEEKDAY ( [Date], 2 ) >= 6,
				        "Year Month", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				    )

	annotation PBI_Id = 33062f06345255f6b108
